# Параметры стека n8n. Скопировать в .env (gitignored) или задать как Env стека
# в оркестраторе (Portainer и т.п.).

# --- хост ---
TZ=UTC
# uid:gid владельца каталогов записей и vault (иначе запись упрётся в ACL NAS)
N8N_UID=1000
N8N_GID=1000
# каталог данных n8n: внутри появятся n8n/ (home, SQLite) и state/ (реестр, outbox);
# сюда же кладётся recap-exporter.py (монтируется в контейнер экспортера)
N8N_DATA_DIR=/srv/docker/n8n
# каталог с записями: подкаталог = тип (CallRecords, Meetings, Voice, ...)
RECORDINGS_DIR=/srv/recordings
# корень Obsidian vault (заметки попадут в Notes/Recordings/<год>/)
VAULT_DIR=/srv/obsidian/vault
N8N_PORT=5678
N8N_SUBNET=172.28.0.0/28
N8N_WEBHOOK_URL=http://nas.local:5678/

# --- метрики (Prometheus-формат, без аутентификации — только LAN) ---
# /metrics движка n8n на порту UI; false — выключить
N8N_METRICS=true
# порт recap-exporter (реестр и outbox конвейера)
RECAP_EXPORTER_PORT=9819

# --- пайплайн recap ---
RECAP_ASR_URL=http://gpu-host.local:8000
RECAP_BATCH=20
RECAP_OWNER_NAME=Владелец
# сдвиг локального времени от UTC в часах (без DST)
RECAP_TZ_OFFSET_HOURS=0
RECAP_TG_MAX_AGE_DAYS=2

# --- LLM: любой OpenAI-совместимый endpoint ---
LLM_BASE_URL=http://gpu-host.local:11434/v1
LLM_API_KEY=
LLM_MODEL=gemma3-recap
LLM_PROXY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
