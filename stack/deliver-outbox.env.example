# Настройки deliver-outbox.sh. Скопировать в deliver-outbox.env рядом со скриптом.
# outbox на файловой системе NAS (= <N8N_DATA_DIR>/state/outbox)
OUTBOX_DIR=/volume1/docker/n8n/state/outbox
# тот же outbox в нотации общих папок File Station (без /volume1)
OUTBOX_SHARE_PATH=/docker/n8n/state/outbox
# каталог заметок в vault в нотации File Station
DEST_BASE=/homes/user/Obsidian/vault/Notes/Recordings
# необязательно:
# API=/usr/syno/bin/synowebapi
# LOG=/volume1/docker/n8n/deliver-outbox.log
