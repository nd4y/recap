{
  "title": "recap",
  "uid": "recap-pipeline",
  "tags": ["recap"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {"from": "now-7d", "to": "now"},
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_PROMETHEUS",
        "label": "Datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {"type": "row", "title": "Конвейер (реестр и outbox)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 100, "panels": []},

    {
      "type": "stat", "id": 1, "title": "Обработано (done)",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(recap_registry_files{status=\"done\"})", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "color": {"mode": "fixed", "fixedColor": "green"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "type": "stat", "id": 2, "title": "failed",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(recap_registry_files{status=\"failed\"})", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "type": "stat", "id": 3, "title": "skipped (короче порога)",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(recap_registry_files{status=\"skipped\"})", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "color": {"mode": "fixed", "fixedColor": "text"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "type": "stat", "id": 4, "title": "В работе (processing + noted)",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(recap_registry_files{status=~\"processing|noted\"})", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "color": {"mode": "fixed", "fixedColor": "blue"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "type": "stat", "id": 5, "title": "Последний тик workflow",
      "description": "time() - mtime реестра. Тик каждые 5 минут; больше 15 минут — n8n лежит или workflow деактивирован.",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "time() - recap_registry_updated_timestamp_seconds", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 600}, {"color": "red", "value": 900}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "type": "stat", "id": 6, "title": "Outbox: заметок в очереди",
      "description": "Заметки ждут планировщик NAS (раз в 5 минут). Не пустеет — смотреть deliver-outbox.log.",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "recap_outbox_files", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value"}
    },

    {
      "type": "timeseries", "id": 7, "title": "Обработано файлов в час, по типу",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum by (type) (increase(recap_registry_files{status=\"done\"}[1h]))", "legendFormat": "{{type}}", "interval": "1h"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "custom": {"drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "stacking": {"mode": "normal", "group": "A"}, "axisSoftMin": 0}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}}
    },
    {
      "type": "timeseries", "id": 8, "title": "Секунд обработки на секунду аудио",
      "description": "По полям реестра asr_seconds / llm_seconds / duration за окно 6 ч. ASR: 0.04 = запись 18 минут за ~45 с.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "sum(increase(recap_registry_asr_seconds_sum[6h])) / sum(increase(recap_registry_audio_seconds_sum[6h]))", "legendFormat": "ASR"},
        {"refId": "B", "expr": "sum(increase(recap_registry_llm_seconds_sum[6h])) / sum(increase(recap_registry_audio_seconds_sum[6h]))", "legendFormat": "LLM"}
      ],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 2, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "spanNulls": true, "axisSoftMin": 0}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}}
    },

    {
      "type": "stat", "id": 9, "title": "Давность последней записи",
      "description": "time() - mtime самой свежей записи в реестре. Растёт неделями — синхронизация с телефона встала.",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "time() - max(recap_registry_last_recording_timestamp_seconds)", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "text"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "none", "graphMode": "none", "textMode": "value"}
    },
    {
      "type": "stat", "id": 10, "title": "Последний failed",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 13},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "time() - recap_registry_last_transition_timestamp_seconds{status=\"failed\"}", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "noValue": "не было", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "text", "value": 86400}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "type": "stat", "id": 11, "title": "Файлов с повторными попытками",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 13},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(recap_registry_retried_files)", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "color": {"mode": "fixed", "fixedColor": "text"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "none", "graphMode": "none", "textMode": "value"}
    },
    {
      "type": "stat", "id": 12, "title": "Самая старая заметка в outbox",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 13},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "recap_outbox_oldest_age_seconds", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 900}, {"color": "red", "value": 1800}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value"}
    },

    {"type": "row", "title": "recap-asr (GPU-хост)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17}, "id": 101, "panels": []},

    {
      "type": "stat", "id": 20, "title": "Сервис",
      "description": "GPU-хост выключен — сервис недоступен, это штатно: файлы ждут в очереди.",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "max(up{job=\"recap-asr\"})", "instant": true}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "недоступен", "color": "text"}, "1": {"text": "работает", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "type": "stat", "id": 21, "title": "Запросов в обработке",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "max(recap_asr_inflight)", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "color": {"mode": "fixed", "fixedColor": "blue"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "type": "stat", "id": 22, "title": "Моделей в VRAM",
      "description": "После каждого запроса модели выгружаются (VRAM делится с LLM). Держится 3 — выгрузка сломалась.",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(recap_asr_model_loaded)", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "color": {"mode": "fixed", "fixedColor": "text"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "none", "graphMode": "none", "textMode": "value"}
    },
    {
      "type": "stat", "id": 23, "title": "Владелец опознан",
      "description": "Доля диаризованных запросов, где нашёлся спикер с is_owner. Падает — эталон голоса устарел или порог высок.",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(increase(recap_asr_owner_total{result=\"found\"}[7d])) / sum(increase(recap_asr_owner_total[7d]))", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 0, "noValue": "нет данных", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.5}, {"color": "green", "value": 0.8}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "type": "stat", "id": 24, "title": "Аудио за сутки",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(increase(recap_asr_audio_seconds_total{result=\"ok\"}[24h]))", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "text"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "none", "graphMode": "none", "textMode": "value"}
    },
    {
      "type": "stat", "id": 25, "title": "Запросов за сутки",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum by (result) (increase(recap_asr_requests_total[24h]))", "legendFormat": "{{result}}", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "text"}}, "overrides": [
        {"matcher": {"id": "byName", "options": "undecodable"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
        {"matcher": {"id": "byName", "options": "error"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
      ]},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "orientation": "horizontal"}
    },
    {
      "type": "timeseries", "id": 26, "title": "Время GPU по стадиям, секунд в час",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum by (stage) (increase(recap_asr_stage_seconds_total[1h]))", "legendFormat": "{{stage}}", "interval": "1h"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "custom": {"drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "stacking": {"mode": "normal", "group": "A"}, "axisSoftMin": 0}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}}
    },
    {
      "type": "timeseries", "id": 27, "title": "Длительность запроса, p50 / p95",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(recap_asr_request_seconds_bucket[6h])))", "legendFormat": "p50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(recap_asr_request_seconds_bucket[6h])))", "legendFormat": "p95"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "spanNulls": true, "axisSoftMin": 0}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}}
    },

    {"type": "row", "title": "n8n (движок)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 30}, "id": 102, "panels": []},

    {
      "type": "timeseries", "id": 30, "title": "Экзекьюшены в час, по статусу",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 31},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum by (status) (increase(n8n_workflow_execution_duration_seconds_count[1h]))", "legendFormat": "{{status}}", "interval": "1h"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "custom": {"drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "stacking": {"mode": "normal", "group": "A"}, "axisSoftMin": 0}}, "overrides": [
        {"matcher": {"id": "byName", "options": "success"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
        {"matcher": {"id": "byName", "options": "error"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
        {"matcher": {"id": "byName", "options": "crashed"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
      ]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}}
    },
    {
      "type": "timeseries", "id": 31, "title": "Средняя длительность экзекьюшена",
      "description": "Тик без файлов — доли секунды; тик с батчем — минуты (ASR + LLM на каждый файл).",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 31},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(increase(n8n_workflow_execution_duration_seconds_sum[1h])) / sum(increase(n8n_workflow_execution_duration_seconds_count[1h]))", "legendFormat": "среднее за час"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 1, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true, "axisSoftMin": 0}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": false}, "tooltip": {"mode": "single", "sort": "none"}}
    },
    {
      "type": "timeseries", "id": 32, "title": "Память процесса n8n",
      "description": "Лимит контейнера в compose — 1 ГБ.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 31},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "max(n8n_process_resident_memory_bytes)", "legendFormat": "RSS"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true, "axisSoftMin": 0, "thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}, {"color": "red", "value": 1073741824}]}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": false}, "tooltip": {"mode": "single", "sort": "none"}}
    },
    {
      "type": "stat", "id": 33, "title": "Версия n8n",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 39},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "max by (version) (n8n_version_info)", "legendFormat": "{{version}}", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "text"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "none", "graphMode": "none", "textMode": "name"}
    },
    {
      "type": "stat", "id": 34, "title": "Активных workflow",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 39},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "max(n8n_active_workflow_count)", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "type": "stat", "id": 35, "title": "Лаг event loop, p99",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 39},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "max(n8n_nodejs_eventloop_lag_p99_seconds)", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.1}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value"}
    }
  ]
}
